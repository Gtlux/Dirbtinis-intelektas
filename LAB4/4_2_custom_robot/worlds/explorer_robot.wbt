#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  basicTimeStep 16
  inkEvaporation 0.02
}
Viewpoint {
  orientation -0.28 0.45 0.85 1.3
  position -0.1 -1.4 1.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}
# RectangleArena turi floor SU boundingObject + sienas (Pen piešia tik ant boundingObject)
RectangleArena {
  floorSize 1.5 1.5
  floorTileSize 0.5 0.5
  wallHeight 0.1
}
# --- Šviesos šaltinis ---
DEF LIGHT_SOURCE PointLight {
  attenuation 0 0 1
  color 1 1 0.8
  intensity 3
  location 0.5 0.4 0.25
}
DEF LIGHT_MARKER Solid {
  translation 0.5 0.4 0.15
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 1 0
        roughness 0.3
        metalness 0
        emissiveColor 1 1 0
      }
      geometry Sphere {
        radius 0.03
        subdivision 2
      }
    }
  ]
  name "light marker"
}
# --- Kliūtys ---
DEF OBS_1 Solid {
  translation 0.3 -0.2 0.05
  children [
    DEF BOX_OBS Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.2 0.1
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 0.12 0.12 0.1
      }
    }
  ]
  name "obstacle 1"
  boundingObject USE BOX_OBS
}
DEF OBS_2 Solid {
  translation -0.3 0.3 0.05
  children [
    DEF CYL_OBS Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.6 0.2
        roughness 0.6
        metalness 0
      }
      geometry Cylinder {
        height 0.1
        radius 0.08
      }
    }
  ]
  name "obstacle 2"
  boundingObject USE CYL_OBS
}
DEF OBS_3 Solid {
  translation -0.2 -0.4 0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.3 0.8
        roughness 0.5
        metalness 0
      }
      geometry Box {
        size 0.08 0.2 0.1
      }
    }
  ]
  name "obstacle 3"
  boundingObject Box {
    size 0.08 0.2 0.1
  }
}
DEF OBS_4 Solid {
  translation 0.4 0.4 0.05
  rotation 0 0 1 0.7854
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.5 0.1
        roughness 0.7
        metalness 0
      }
      geometry Box {
        size 0.15 0.06 0.1
      }
    }
  ]
  name "obstacle 4"
  boundingObject Box {
    size 0.15 0.06 0.1
  }
}
DEF BALL_1 Solid {
  translation -0.4 -0.1 0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.1 0.5
        roughness 0.3
        metalness 0
      }
      geometry Sphere {
        radius 0.04
        subdivision 2
      }
    }
  ]
  name "ball"
  boundingObject Sphere {
    radius 0.04
  }
  physics Physics {
    mass 0.05
  }
}
# ================================================================
# EXPLORER ROBOT
# ================================================================
Robot {
  translation 0 0 0
  rotation 0 0 1 0.0
  children [
    Pose {
      translation 0 0 0.04
      children [
        DEF BODY Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.15 0.25
            roughness 0.5
            metalness 0.3
          }
          geometry Box {
            size 0.2 0.1 0.05
          }
        }
      ]
    }
    Pose {
      translation 0.09 0 0.05
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.5 0.5 0.6
            roughness 0.8
            metalness 0.2
          }
          geometry Box {
            size 0.03 0.08 0.03
          }
        }
      ]
    }
    # === RATŲ VARIKLIAI ===
    DEF WHEEL1 HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.05 0.06 0.025
      }
      device [
        RotationalMotor {
          name "wheel1"
        }
      ]
      endPoint Solid {
        translation 0.05 0.06 0.025
        rotation 1 0 0 1.5708
        children [
          DEF WHEEL Shape {
            appearance PBRAppearance {
              baseColor 0.2 0.2 0.2
              roughness 1
              metalness 0.1
            }
            geometry Cylinder {
              height 0.02
              radius 0.025
              subdivision 24
            }
          }
        ]
        name "wheel1"
        boundingObject USE WHEEL
        physics Physics {
        }
      }
    }
    DEF WHEEL2 HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.05 -0.06 0.025
      }
      device [
        RotationalMotor {
          name "wheel2"
        }
      ]
      endPoint Solid {
        translation 0.05 -0.06 0.025
        rotation 1 0 0 1.5708
        children [
          USE WHEEL
        ]
        name "wheel2"
        boundingObject USE WHEEL
        physics Physics {
        }
      }
    }
    DEF WHEEL3 HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.05 0.06 0.025
      }
      device [
        RotationalMotor {
          name "wheel3"
        }
      ]
      endPoint Solid {
        translation -0.05 0.06 0.025
        rotation 1 0 0 1.5708
        children [
          USE WHEEL
        ]
        name "wheel3"
        boundingObject USE WHEEL
        physics Physics {
        }
      }
    }
    DEF WHEEL4 HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.05 -0.06 0.025
      }
      device [
        RotationalMotor {
          name "wheel4"
        }
      ]
      endPoint Solid {
        translation -0.05 -0.06 0.025
        rotation 1 0 0 1.5708
        children [
          USE WHEEL
        ]
        name "wheel4"
        boundingObject USE WHEEL
        physics Physics {
        }
      }
    }
    # === ATSTUMO SENSORIAI ===
    DEF DS_LEFT DistanceSensor {
      translation 0.1 0.03 0.04
      rotation 0 0 1 0.3
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.0 0.8 0.8
            roughness 1
            metalness 0
          }
          geometry Box {
            size 0.01 0.01 0.01
          }
        }
      ]
      name "ds_left"
      lookupTable [
        0 1000 0
        0.05 1000 0
        0.4 0 0
      ]
      numberOfRays 2
      aperture 1
    }
    DEF DS_RIGHT DistanceSensor {
      translation 0.1 -0.03 0.04
      rotation 0 0 1 -0.3
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.0 0.8 0.8
            roughness 1
            metalness 0
          }
          geometry Box {
            size 0.01 0.01 0.01
          }
        }
      ]
      name "ds_right"
      lookupTable [
        0 1000 0
        0.05 1000 0
        0.4 0 0
      ]
      numberOfRays 2
      aperture 1
    }
    # === ŠVIESOS SENSORIUS ===
    DEF LIGHT_SENSOR LightSensor {
      translation 0.1 0 0.055
      rotation 0 0 1 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 1 0
            roughness 1
            metalness 0
          }
          geometry Box {
            size 0.008 0.008 0.008
          }
        }
      ]
      name "light_sensor"
      lookupTable [
        0 0 0
        1000 1000 0
      ]
    }
    # === GPS ===
    GPS {
      name "gps"
    }
    # === LED ===
    DEF LED_LEFT LED {
      translation 0.07 0.04 0.065
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.1 0.1
            roughness 0.5
            metalness 0
          }
          geometry Sphere {
            radius 0.007
            subdivision 2
          }
        }
      ]
      name "led_left"
      color [0 1 0]
    }
    DEF LED_RIGHT LED {
      translation 0.07 -0.04 0.065
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.1 0.1
            roughness 0.5
            metalness 0
          }
          geometry Sphere {
            radius 0.007
            subdivision 2
          }
        }
      ]
      name "led_right"
      color [1 0 0]
    }
    # === PEN (kaip oficialiam Webots pen pavyzdyje) ===
    Pen {
      translation 0 0 0.001
      children [
        Pose {
          translation 0 0 0.04
          children [
            Shape {
              appearance PBRAppearance {
                baseColor 0.9 0.2 0.1
                roughness 1
                metalness 0
              }
              geometry Cylinder {
                height 0.08
                radius 0.003
              }
            }
          ]
        }
      ]
      name "pen"
      inkColor 0.9 0.1 0.1
      inkDensity 0.8
      leadSize 0.01
    }
  ]
  name "explorer_robot"
  boundingObject Pose {
    translation 0 0 0.04
    children [
      Box {
        size 0.2 0.1 0.05
      }
    ]
  }
  physics Physics {
    density -1
    mass 0.5
    centerOfMass [
      0 0 0
    ]
  }
  controller "explorer_controller"
}
