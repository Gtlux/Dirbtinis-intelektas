@startuml

' =============================================================================
' 2.4.4 — UML diagramos: Medicininė simptomų diagnostikos ekspertinė sistema
' Sugeneruota naudojant PlantUML kalbą (reverse engineering)
' =============================================================================

' ─────────────────────────────────────────────────────────────────────────────
' 1. ACTIVITY DIAGRAM — Veiklos diagrama
' ─────────────────────────────────────────────────────────────────────────────

title Activity Diagram: Ekspertinės sistemos veikla

start

:Vartotojas iveda paciento duomenis\n(vardas, amzius, temperatura);

:Vartotojas pasirenka simptomus\n(kosulys, sloga, galvos skausmas...);

:Sistema sukuria paciento objekta\n(create_patient() funkcija);

note right
  Temperatura > 37.5°C →
  fever = True (automatiskai)
end note

:Sistema inicijuoja ExpertSystem\nsu taisykliu baze (10 taisykliu);

:Sistema eina per kiekviena taisykle;

while (Ar yra dar nepatikrintu taisykliu?) is (Taip)
  :Paimama sekanti taisykle;
  if (Taisyklė atitinka simptomus?\n(rule.matches(patient))) then (Taip)
    :Diagnozė pridedama i\nrastų diagnozių sąrašą;
  else (Ne)
    :Praleidziama;
  endif
endwhile (Ne)

if (Ar rasta bent viena diagnoze?) then (Taip)
  :Atspausdinama ataskaita su\ndiagnozemis ir rekomendacijomis;
else (Ne)
  :Pranesimas: "Neimanoma nustatyti\ndiagnozes. Kreipkites i gydytoja.";
endif

stop

@enduml

' ─────────────────────────────────────────────────────────────────────────────
' 2. STATE MACHINE DIAGRAM — Būsenų diagrama
' ─────────────────────────────────────────────────────────────────────────────

@startuml

title State Machine Diagram: Ekspertinės sistemos būsenos

[*] --> Laukimas

Laukimas : Sistema paruosta darbui
Laukimas --> DuomenuIvedimas : Vartotojas pradeda\nivesti duomenis

DuomenuIvedimas : Ivesti vardas, amzius,\ntemperatura
DuomenuIvedimas --> SimptomuRinkimas : Pagrindiai duomenys ivesti

SimptomuRinkimas : Vartotojas pasirenka\nsimptomus is saraso
SimptomuRinkimas --> PacientoKurimas : Visi simptomai pasirinkti
SimptomuRinkimas --> SimptomuRinkimas : Papildomi simptomai

PacientoKurimas : create_patient() sukuria\nduomenu struktura
PacientoKurimas --> TaisykliuVertinimas : Paciento objektas sukurtas

TaisykliuVertinimas : Inference engine eina\nper visas taisykles
TaisykliuVertinimas --> DiagnozeRasta : >= 1 taisykle atitiko
TaisykliuVertinimas --> DiagnozeNerasta : 0 taisykliu atitiko

DiagnozeRasta : Suformuotas diagnoziu\nsarasas su tikimybemis
DiagnozeRasta --> AtaskaitosGeneravimas : Pereiti i ataskaita

DiagnozeNerasta : Jokia taisykle neatitiko
DiagnozeNerasta --> AtaskaitosGeneravimas : Bendrinis pranesimas

AtaskaitosGeneravimas : Formuojama galutine\nataskaita vartotojui
AtaskaitosGeneravimas --> Laukimas : Ataskaita pateikta\n(grizti i pradzia)
AtaskaitosGeneravimas --> [*] : Sistema uzdaryta

@enduml

' ─────────────────────────────────────────────────────────────────────────────
' 3. SEQUENCE DIAGRAM — Seku diagrama
' ─────────────────────────────────────────────────────────────────────────────

@startuml

title Sequence Diagram: Diagnostikos procesas

actor Vartotojas
participant "create_patient()" as Factory
participant "ExpertSystem" as Expert
participant "Rule (rule-engine)" as Rules
participant "Ataskaita" as Report

Vartotojas -> Factory : Iveda duomenis\n(vardas, amzius, temp, simptomai)
activate Factory

Factory -> Factory : Apskaiciuoja fever =\n(temperature > 37.5)
Factory --> Vartotojas : Grazina patient dict
deactivate Factory

Vartotojas -> Expert : diagnose(patient)
activate Expert

loop Kiekvienai taisyklei (10 taisykliu)
    Expert -> Rules : rule.matches(patient)
    activate Rules
    Rules -> Rules : Ivertina logine israiska\n(pvz., "fever AND cough AND...")
    Rules --> Expert : True / False
    deactivate Rules

    alt Taisykle atitinka (True)
        Expert -> Expert : Prideda diagnoze\ni sarasa
    end
end

Expert --> Vartotojas : Grazina diagnoziu sarasa
deactivate Expert

Vartotojas -> Report : print_report(patient)
activate Report
Report -> Report : Formatuoja simptomus
Report -> Expert : diagnose(patient)
Report -> Report : Formatuoja diagnozes\nsu tikimybemis
Report --> Vartotojas : Atspausdinta ataskaita
deactivate Report

@enduml

' ─────────────────────────────────────────────────────────────────────────────
' 4. CLASS DIAGRAM — Klasiu diagrama
' ─────────────────────────────────────────────────────────────────────────────

@startuml

title Class Diagram: Ekspertinės sistemos struktūra

class Patient <<dict>> {
    + name : str
    + age : int
    + temperature : float
    + fever : bool
    + cough : bool
    + sore_throat : bool
    + runny_nose : bool
    + headache : bool
    + body_aches : bool
    + fatigue : bool
    + nausea : bool
    + rash : bool
    + shortness_of_breath : bool
}

class RuleEntry <<dict>> {
    + diagnosis : str
    + confidence : str
    + rule : Rule
    + recommendation : str
}

class ExpertSystem {
    - rules : list[RuleEntry]
    + __init__(rules: list)
    + diagnose(patient: dict) : list[dict]
    + print_report(patient: dict) : list[dict]
}

class "rule_engine.Rule" as Rule {
    + __init__(expression: str)
    + matches(data: dict) : bool
    + filter(data: list) : iterator
}

class DiagnosisResult <<dict>> {
    + diagnosis : str
    + confidence : str
    + recommendation : str
}

note top of Patient
  Sukuriamas naudojant
  create_patient() funkcija
end note

note top of Rule
  Isore biblioteka:
  rule-engine (PyPI)
end note

ExpertSystem "1" *-- "10" RuleEntry : turi taisykles >
RuleEntry "1" *-- "1" Rule : naudoja >
ExpertSystem ..> Patient : priima kaip iranga
ExpertSystem ..> DiagnosisResult : grazina rezultatus
Rule ..> Patient : tikrina atitikima

package "Funkcijos" {
    class create_patient <<function>> {
        {static} create_patient(name, age, temp, ...) : dict
    }
}

create_patient ..> Patient : sukuria

@enduml
